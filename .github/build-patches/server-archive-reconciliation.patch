+              </WrapPanel>
+            </Grid>
+          </Border>
+          <TextBlock Text="Trusted clients" FontWeight="SemiBold" />
+          <ListBox ItemsSource="{Binding PairedClients}" SelectedItem="{Binding SelectedPairedClient, Mode=TwoWay}"
+                   MaxHeight="220" Background="Transparent" BorderThickness="0" IsVisible="{Binding HasPairedClients}">
+            <ListBox.ItemTemplate>
+              <DataTemplate>
+                <Border Background="#151A20" BorderBrush="#343B45" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,6">
+                  <StackPanel Spacing="3">
+                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
+                    <TextBlock Text="{Binding DetailText}" Classes="muted" FontSize="10" />
+                  </StackPanel>
+                </Border>
+              </DataTemplate>
+            </ListBox.ItemTemplate>
+          </ListBox>
+          <TextBlock Text="No native clients are currently paired." Classes="muted" IsVisible="{Binding !HasPairedClients}" />
+          <WrapPanel ItemSpacing="8" LineSpacing="8">
+            <Button Content="Revoke selected client" Classes="secondary" Command="{Binding RevokeClientCommand}" />
+            <Button Content="Revoke every client" Classes="secondary" Command="{Binding RevokeAllClientsCommand}" />
+          </WrapPanel>
+        </StackPanel>
+      </Border>
+
+      <Button Content="Save access settings" Classes="primary" Command="{Binding SaveCommand}" HorizontalAlignment="Right" MinWidth="190" />
+    </StackPanel>
+  </ScrollViewer>
+</UserControl>
