<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RadioVault.Server</AssemblyName>
    <RootNamespace>TheRadioVault.Server</RootNamespace>
    <Product>RadioVault Server</Product>
    <Version>0.35.0-alpha9-buildfix3</Version>
    <AssemblyVersion>0.35.0.9</AssemblyVersion>
    <FileVersion>0.35.0.9</FileVersion>
    <InformationalVersion>0.35.0-alpha9-buildfix3</InformationalVersion>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\RadioVault.Server.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TheRadioVault.Application\TheRadioVault.Application.csproj" />
    <ProjectReference Include="..\TheRadioVault.Infrastructure\TheRadioVault.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\RadioVault.Server.ico" />
    <AvaloniaResource Include="Assets\RadioVault.Server-Logo.png" />
  </ItemGroup>
</Project>
