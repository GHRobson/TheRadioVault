<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RadioVault.Server</AssemblyName>
    <RootNamespace>TheRadioVault.Server</RootNamespace>
    <Product>RadioVault Server</Product>
    <Version>$(RadioVaultProductVersion)</Version>
    <AssemblyVersion>$(RadioVaultAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(RadioVaultAssemblyVersion)</FileVersion>
    <InformationalVersion>$(RadioVaultInformationalVersion)</InformationalVersion>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon Condition="'$(OS)' == 'Windows_NT' Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">Assets\RadioVault.Server.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TheRadioVault.Application\TheRadioVault.Application.csproj" />
    <ProjectReference Include="..\TheRadioVault.Infrastructure\TheRadioVault.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\RadioVault.Server.ico" />
    <AvaloniaResource Include="Assets\RadioVault.Server-Logo.png" />
  </ItemGroup>
</Project>
