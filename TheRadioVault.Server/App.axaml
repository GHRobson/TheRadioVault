<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheRadioVault.Server.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#101318" />
      <Setter Property="Foreground" Value="#F4F2EC" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1B2027" />
      <Setter Property="BorderBrush" Value="#343B45" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#AEB5BF" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#D6B84B" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#D6B84B" />
      <Setter Property="BorderBrush" Value="#D6B84B" />
      <Setter Property="Foreground" Value="#17140A" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#252B33" />
      <Setter Property="BorderBrush" Value="#3A424D" />
      <Setter Property="Foreground" Value="#F4F2EC" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.42" />
    </Style>
    <Style Selector="ScrollViewer">
      <Setter Property="AllowAutoHide" Value="True" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Background" Value="#101318" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="MinWidth" Value="190" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="16,11" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="#F2C94C" />
    </Style>
  </Application.Styles>
</Application>
