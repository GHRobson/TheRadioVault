<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheRadioVault.Server.Views.ServerDashboardView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="26" Spacing="16">
      <StackPanel Spacing="4">
        <TextBlock Text="SERVER DASHBOARD" Classes="eyebrow" />
        <TextBlock Text="Your archive at a glance" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="Live service state, storage health and anything that needs attention." Classes="muted" FontSize="12" />
      </StackPanel>

      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
              <TextBlock Text="SERVER STATUS" Classes="eyebrow" />
              <TextBlock Text="{Binding StatusText}" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DetailText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Background="{Binding ServerStateBrush}" CornerRadius="999" Padding="13,7" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="10" Height="10" CornerRadius="5" Background="#FFFFFF" Opacity="0.92" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ServerStateLabel}" Foreground="#101318" FontWeight="Bold" FontSize="10" />
              </StackPanel>
            </Border>
          </Grid>
          <TextBox Grid.Row="1" Text="{Binding AccessUrl}" IsReadOnly="True"
                   PlaceholderText="The access address appears when the server is running" />
          <WrapPanel Grid.Row="2" ItemSpacing="8" LineSpacing="8">
            <Button Content="Start server" Classes="primary" Command="{Binding StartCommand}" IsVisible="{Binding IsServerStopped}" />
            <Button Content="Stop server" Classes="secondary" Command="{Binding StopCommand}" IsVisible="{Binding IsServerRunning}" />
            <Button Content="Open Radio Vault Web" Classes="secondary" Command="{Binding OpenAnywhereCommand}" />
          </WrapPanel>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
        <Border Classes="card">
          <StackPanel Spacing="5">
            <TextBlock Text="DATABASE" Classes="eyebrow" />
            <TextBlock Text="{Binding DatabaseHealthText}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="5">
            <TextBlock Text="ARCHIVE MEDIA" Classes="eyebrow" />
            <TextBlock Text="{Binding MediaHealthText}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Classes="card">
          <StackPanel Spacing="5">
            <TextBlock Text="VERIFIED BACKUP" Classes="eyebrow" />
            <TextBlock Text="{Binding BackupHealthText}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Classes="card">
          <StackPanel Spacing="5">
            <TextBlock Text="SECURE ACCESS" Classes="eyebrow" />
            <TextBlock Text="{Binding CertificateHealthText}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Grid.ColumnSpan="2" Classes="card">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel Spacing="5">
              <TextBlock Text="ARCHIVE RECONCILIATION" Classes="eyebrow" />
              <TextBlock Text="{Binding ArchiveReconciliationDashboardText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="The detailed evidence and safe consolidation workflow are available in Archive Reconciliation."
                         Classes="muted" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Background="{Binding ArchiveReconciliationStateBrush}" CornerRadius="999" Padding="12,7" VerticalAlignment="Top">
              <TextBlock Text="{Binding ArchiveReconciliationStateLabel}" Foreground="#101318" FontWeight="Bold" FontSize="9" />
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Border Background="#161A20" BorderBrush="#343B45" BorderThickness="1" CornerRadius="10" Padding="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <StackPanel Spacing="3">
            <TextBlock Text="BACKGROUND SERVICE" Classes="eyebrow" />
            <TextBlock Text="{Binding StartupStatusText}" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="Closing this window hides it; the server keeps running from the tray." Classes="muted" FontSize="10" />
          </StackPanel>
          <CheckBox Grid.Column="1" Content="{Binding StartAutomaticallyLabel}"
                    IsChecked="{Binding StartAutomatically}" IsEnabled="False" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
