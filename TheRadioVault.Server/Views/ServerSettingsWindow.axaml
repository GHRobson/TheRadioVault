<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TheRadioVault.Server.Views"
        x:Class="TheRadioVault.Server.Views.ServerSettingsWindow"
        Title="Radio Vault Server"
        Width="1080" Height="800" MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*">
    <Border Background="#161A20" BorderBrush="#343B45" BorderThickness="0,0,0,1" Padding="22,16">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Image Width="50" Height="50" Source="/Assets/RadioVault.Server-Logo.png"
               Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="RADIO VAULT SERVER" Classes="eyebrow" />
          <TextBlock Text="Archive administration" FontSize="23" FontWeight="Bold" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Border Background="{Binding ServerStateBrush}" CornerRadius="999" Padding="11,6" HorizontalAlignment="Right">
            <TextBlock Text="{Binding ServerStateLabel}" Foreground="#101318" FontWeight="Bold" FontSize="9" />
          </Border>
          <TextBlock Text="{Binding VersionText}" Classes="muted" FontSize="10" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" TabStripPlacement="Left" SelectedIndex="0">
      <TabItem Header="Dashboard"><views:ServerDashboardView /></TabItem>
      <TabItem Header="Library"><views:ServerLibraryView /></TabItem>
      <TabItem Header="Archive Reconciliation"><views:ServerReconciliationView /></TabItem>
      <TabItem Header="Automation"><views:ServerAutomationView /></TabItem>
      <TabItem Header="Knowledge"><views:ServerKnowledgeView /></TabItem>
      <TabItem Header="Transcription"><views:ServerTranscriptionView /></TabItem>
      <TabItem Header="Access"><views:ServerAccessView /></TabItem>
      <TabItem Header="Recovery"><views:ServerRecoveryView /></TabItem>
    </TabControl>
  </Grid>
</Window>
