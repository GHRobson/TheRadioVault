<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TheRadioVault.Server.Views.ServerSettingsWindow"
        Title="RadioVault Server settings"
        Width="820" Height="780" MinWidth="700" MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28" Spacing="16">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Image Width="56" Height="56" Source="/Assets/RadioVault.Server-Logo.png"
               Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="RADIOVAULT SERVER" Classes="eyebrow" />
          <TextBlock Text="Background archive service" FontSize="27" FontWeight="Bold" />
          <TextBlock Text="This application owns the archive and serves Radio Vault clients. It contains settings only."
                     Classes="muted" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding VersionText}" Classes="muted" FontSize="11"
                   VerticalAlignment="Top" />
      </Grid>

      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
              <TextBlock Text="SERVER STATUS" Classes="eyebrow" />
              <TextBlock Text="{Binding StatusText}" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DetailText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Background="{Binding ServerStateBrush}" CornerRadius="999" Padding="13,7"
                    VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="10" Height="10" CornerRadius="5" Background="#FFFFFF" Opacity="0.92" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ServerStateLabel}" Foreground="#101318" FontWeight="Bold" FontSize="10" />
              </StackPanel>
            </Border>
          </Grid>
          <TextBox Grid.Row="1" Text="{Binding AccessUrl}" IsReadOnly="True"
                   PlaceholderText="The access address appears when the server is running" />
          <WrapPanel Grid.Row="2" ItemSpacing="8" LineSpacing="8">
            <Button Content="Start server" Classes="primary" Command="{Binding StartCommand}" IsVisible="{Binding IsServerStopped}" />
            <Button Content="Stop server" Classes="secondary" Command="{Binding StopCommand}" IsVisible="{Binding IsServerRunning}" />
            <Button Content="Open Radio Vault Web" Classes="secondary" Command="{Binding OpenAnywhereCommand}" />
          </WrapPanel>
        </Grid>
      </Border>

      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="22">
          <StackPanel Spacing="12">
            <StackPanel Spacing="3">
              <TextBlock Text="RADIO VAULT WEB" Classes="eyebrow" />
              <TextBlock Text="Phone, tablet and browser access" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="Radio Vault Web is hosted by this server computer. Scan the code with a phone on the same network, or copy the private link."
                         Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <TextBox Text="{Binding AccessUrl}" IsReadOnly="True"
                     PlaceholderText="Start the server to create the private Web address" />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Content="Open Web" Classes="primary" Command="{Binding OpenAnywhereCommand}" />
              <Button Content="Copy phone link" Classes="secondary" Command="{Binding CopyWebLinkCommand}" />
              <Button Content="Phone HTTPS setup" Classes="secondary" Command="{Binding OpenSecureSetupCommand}"
                      IsVisible="{Binding IsServerSecure}" />
              <Button Content="Create a new private link" Classes="secondary" Command="{Binding RegenerateWebLinkCommand}" />
            </WrapPanel>
            <TextBlock Text="Creating a new private link signs existing Web browsers out. It does not unpair native Radio Vault clients."
                       Classes="muted" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Top">
            <TextBlock Text="SCAN TO OPEN WEB" Classes="eyebrow" HorizontalAlignment="Center"
                       IsVisible="{Binding WebQrCode.IsAvailable}" />
            <Border Background="#FFFFFF" CornerRadius="12" Padding="10" IsVisible="{Binding WebQrCode.IsAvailable}">
              <ItemsControl ItemsSource="{Binding WebQrCode.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ItemsControl ItemsSource="{Binding Cells}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate><Border Width="4" Height="4" Background="{Binding Fill}" /></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <TextBlock Text="FIRST-TIME HTTPS SETUP" Classes="eyebrow" HorizontalAlignment="Center"
                       IsVisible="{Binding SecureSetupQrCode.IsAvailable}" />
            <Border Background="#FFFFFF" CornerRadius="10" Padding="8" HorizontalAlignment="Center"
                    IsVisible="{Binding SecureSetupQrCode.IsAvailable}">
              <ItemsControl ItemsSource="{Binding SecureSetupQrCode.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ItemsControl ItemsSource="{Binding Cells}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate><Border Width="3" Height="3" Background="{Binding Fill}" /></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="4">
            <TextBlock Text="BACKGROUND LIFECYCLE" Classes="eyebrow" />
            <TextBlock Text="Runs without an open settings window" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StartupStatusText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="Closing this window hides it. Use the Radio Vault tray icon to reopen settings or exit the server."
                       Classes="muted" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
          <CheckBox Grid.Column="1" Content="{Binding StartAutomaticallyLabel}"
                    IsChecked="{Binding StartAutomatically, Mode=TwoWay}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9">
            <StackPanel Spacing="3">
              <TextBlock Text="LIBRARY FOLDERS" Classes="eyebrow" />
              <TextBlock Text="Archive locations on this computer" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="Add folders from the server computer that physically owns the archive. Radio Vault asks which show each folder contains; use mixed only when it really contains several shows. Removing a registration never deletes audio files."
                         Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Scan Library now" Classes="secondary" Command="{Binding ScanLibraryCommand}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Add folder" Classes="primary" Command="{Binding AddLibraryFolderCommand}" VerticalAlignment="Center" />
          </Grid>

          <Border Background="#13171D" BorderBrush="#343B45" BorderThickness="1" CornerRadius="10" Padding="12">
            <TextBlock Text="{Binding LibraryStatusText}" FontSize="11" TextWrapping="Wrap" />
          </Border>

          <ListBox ItemsSource="{Binding LibraryFolders}" SelectedItem="{Binding SelectedLibraryFolder, Mode=TwoWay}"
                   MaxHeight="230" Background="Transparent" BorderThickness="0" IsVisible="{Binding HasLibraryFolders}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#151A20" BorderBrush="#343B45" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding AssignmentDisplayName}" Classes="muted" FontSize="10" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="ENABLED" Foreground="#52D6A2" FontWeight="Bold" FontSize="9"
                               VerticalAlignment="Center" IsVisible="{Binding Enabled}" />
                    <TextBlock Grid.Column="1" Text="DISABLED" Foreground="#E2A84A" FontWeight="Bold" FontSize="9"
                               VerticalAlignment="Center" IsVisible="{Binding !Enabled}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding HasLibraryFolders}">
            <Button Content="Change selected show" Classes="primary" Command="{Binding AssignLibraryFolderCommand}" />
            <Button Content="Enable or disable selected" Classes="secondary" Command="{Binding ToggleLibraryFolderCommand}" />
            <Button Content="Remove selected registration" Classes="secondary" Command="{Binding RemoveLibraryFolderCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel Spacing="3">
              <TextBlock Text="RSS ARCHIVE INBOX" Classes="eyebrow" />
              <TextBlock Text="Automatically collect new broadcasts" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="Radio Vault checks private or public RSS feeds while the Server app is running, downloads new audio into a registered Library folder, then indexes it normally. Feed addresses and credentials remain encrypted on this server."
                         Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Check all now" Classes="secondary"
                    Command="{Binding CheckAllRssFeedsCommand}" VerticalAlignment="Center" />
          </Grid>

          <Border Background="#13171D" BorderBrush="#343B45" BorderThickness="1" CornerRadius="10" Padding="12">
            <TextBlock Text="{Binding RssStatusText}" FontSize="11" TextWrapping="Wrap" />
          </Border>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
            <StackPanel Spacing="5">
              <TextBlock Text="Feed name" Classes="muted" FontSize="10" />
              <TextBox Text="{Binding RssFeedName, Mode=TwoWay}" PlaceholderText="Bennington private feed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Text="Private RSS address" Classes="muted" FontSize="10" />
              <TextBox Text="{Binding RssFeedUrl, Mode=TwoWay}" PlaceholderText="https://…" />
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="5">
              <TextBlock Text="Username (optional)" Classes="muted" FontSize="10" />
              <TextBox Text="{Binding RssUsername, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
              <TextBlock Text="Password (optional)" Classes="muted" FontSize="10" />
              <TextBox Text="{Binding RssPassword, Mode=TwoWay}" PasswordChar="●" />
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="5">
              <TextBlock Text="Archive destination" Classes="muted" FontSize="10" />
              <ComboBox ItemsSource="{Binding RssDestinationFolders}"
                        SelectedItem="{Binding RssDestinationFolder, Mode=TwoWay}"
                        IsEnabled="{Binding HasRssDestinationFolders}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding AssignmentDisplayName}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Path}" Classes="muted" FontSize="9" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="5">
              <TextBlock Text="Check every (minutes)" Classes="muted" FontSize="10" />
              <TextBox Text="{Binding RssIntervalMinutesText, Mode=TwoWay}" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <CheckBox Content="Import episodes already present on the first check"
                        IsChecked="{Binding RssImportExisting, Mode=TwoWay}" />
              <TextBlock Text="Leave this off to establish the current feed as a baseline and download only episodes published afterward."
                         Classes="muted" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Add RSS feed" Classes="primary"
                    Command="{Binding AddRssFeedCommand}" VerticalAlignment="Center" />
          </Grid>

          <ListBox ItemsSource="{Binding RssFeeds}" SelectedItem="{Binding SelectedRssFeed, Mode=TwoWay}"
                   MaxHeight="260" Background="Transparent" BorderThickness="0" IsVisible="{Binding HasRssFeeds}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#151A20" BorderBrush="#343B45" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding DisplayUrl}" Classes="muted" FontSize="10" />
                      <TextBlock Text="{Binding DestinationPath}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding StatusText}" FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding IntervalText}" Classes="muted" FontSize="9" HorizontalAlignment="Right" />
                      <TextBlock Text="ENABLED" Foreground="#52D6A2" FontWeight="Bold" FontSize="9"
                                 HorizontalAlignment="Right" IsVisible="{Binding Enabled}" />
                      <TextBlock Text="PAUSED" Foreground="#E2A84A" FontWeight="Bold" FontSize="9"
                                 HorizontalAlignment="Right" IsVisible="{Binding !Enabled}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding HasRssFeeds}">
            <Button Content="Check selected now" Classes="primary" Command="{Binding CheckSelectedRssFeedCommand}" />
            <Button Content="Enable or pause selected" Classes="secondary" Command="{Binding ToggleRssFeedCommand}" />
            <Button Content="Remove selected feed" Classes="secondary" Command="{Binding DeleteRssFeedCommand}" />
          </WrapPanel>
          <TextBlock Text="Removing a subscription never deletes broadcasts already downloaded into the archive."
                     Classes="muted" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding HasRssFeeds}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <StackPanel Spacing="3">
            <TextBlock Text="KNOWLEDGE DATABASE" Classes="eyebrow" />
            <TextBlock Text="Import, protect and export archive knowledge" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Imports run as cancellable background jobs owned by the server. Closing this window or disconnecting a client does not stop a healthy import. Every import remains transactional and creates a verified safety backup before changing the archive."
                       Classes="muted" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>

          <Border Background="#13171D" BorderBrush="#343B45" BorderThickness="1" CornerRadius="10" Padding="12">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBlock Text="{Binding KnowledgeStatusText}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding KnowledgeProgressCountText}" Classes="muted" FontSize="10"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding KnowledgeProgressPercentText}" FontWeight="Bold"
                           Foreground="#F2C94C" VerticalAlignment="Center" />
              </Grid>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding KnowledgeProgressPercent}"
                           Height="8" Foreground="#F2C94C" Background="#343B45" />
            </StackPanel>
          </Border>

          <Border Background="#1B2027" BorderBrush="#343B45" BorderThickness="1" CornerRadius="9" Padding="12"
                  IsVisible="{Binding HasKnowledgeImportPreview}">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding KnowledgeImportFileText}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding KnowledgeImportPreviewText}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="Choose Knowledge Database…" Classes="primary" Command="{Binding ChooseKnowledgeImportCommand}" />
            <Button Content="Import now" Classes="primary" Command="{Binding ApplyKnowledgeImportCommand}"
                    IsVisible="{Binding HasKnowledgeImportPreview}" />
            <Button Content="Cancel import" Classes="secondary" Command="{Binding CancelKnowledgeImportCommand}"
                    IsVisible="{Binding HasKnowledgeImportPreview}" />
          </WrapPanel>

          <Button Content="Export complete Knowledge Database…" Classes="secondary"
                  HorizontalAlignment="Left" Command="{Binding ExportKnowledgeCommand}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
              <TextBlock Text="TRANSCRIPTION SERVICE" Classes="eyebrow" />
              <TextBlock Text="{Binding TranscriptionStatusText}" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{Binding TranscriptionDetailText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Background="{Binding TranscriptionStateBrush}" CornerRadius="999" Padding="13,7" VerticalAlignment="Top">
              <TextBlock Text="{Binding TranscriptionStateLabel}" Foreground="#101318" FontWeight="Bold" FontSize="10" />
            </Border>
          </Grid>
          <TextBlock Grid.Row="1" Text="Whisper, VAD, diarization, remembered voices and batch jobs continue in the server even when every client is closed."
                     Classes="muted" FontSize="11" TextWrapping="Wrap" />
          <WrapPanel Grid.Row="2" ItemSpacing="8" LineSpacing="8">
            <Button Content="Install recommended transcription setup" Classes="primary" Command="{Binding InstallTranscriptionCommand}"
                    IsVisible="{Binding ShowAutomaticTranscriptionSetup}" />
            <Button Content="Cancel setup" Classes="secondary" Command="{Binding CancelTranscriptionCommand}"
                    IsVisible="{Binding IsTranscriptionBusy}" />
            <TextBlock Text="No setup action is needed." Classes="muted" FontSize="11" VerticalAlignment="Center"
                       IsVisible="{Binding IsTranscriptionReady}" />
            <TextBlock Text="{Binding TranscriptionPlatformGuidance}" Classes="muted" FontSize="11"
                       MaxWidth="540" TextWrapping="Wrap" IsVisible="{Binding !IsAutomaticTranscriptionSetupSupported}" />
          </WrapPanel>
        </Grid>
      </Border>

      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
          <StackPanel Spacing="3">
            <TextBlock Text="SERVER SETTINGS" Classes="eyebrow" />
            <TextBlock Text="Identity and network access" FontSize="17" FontWeight="SemiBold" />
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="170,*" ColumnSpacing="12">
            <TextBlock Text="Server name" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding ServerDisplayName, Mode=TwoWay}" />
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="170,*,20,*" ColumnSpacing="12">
            <TextBlock Text="Network ports" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding HttpPortText, Mode=TwoWay}" PlaceholderText="HTTP" />
            <TextBlock Grid.Column="2" Text="/" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBox Grid.Column="3" Text="{Binding HttpsPortText, Mode=TwoWay}" PlaceholderText="HTTPS" />
          </Grid>
          <WrapPanel Grid.Row="3" ItemSpacing="20" LineSpacing="8">
            <CheckBox Content="Server enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" />
            <CheckBox Content="Secure HTTPS access" IsChecked="{Binding SecureAccessEnabled, Mode=TwoWay}" />
          </WrapPanel>
          <Grid Grid.Row="4" ColumnDefinitions="170,*" ColumnSpacing="12">
            <TextBlock Text="Discovery port" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding LanDiscoveryPortText, Mode=TwoWay}" />
          </Grid>
        </Grid>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel Spacing="3">
              <TextBlock Text="REMOTE NATIVE CLIENTS" Classes="eyebrow" />
              <TextBlock Text="Pair another Radio Vault computer" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="Pairing uses the pinned HTTPS certificate and gives that client its own revocable token."
                         Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Grid.Column="1" Content="Allow remote native clients"
                      IsChecked="{Binding LanFederationEnabled, Mode=TwoWay}" VerticalAlignment="Top" />
          </Grid>

          <Border Background="#13171D" BorderBrush="#343B45" BorderThickness="1" CornerRadius="10" Padding="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <StackPanel Spacing="4">
                <TextBlock Text="ONE-TIME PAIRING CODE" Classes="eyebrow" />
                <TextBlock Text="{Binding PairingCode}" FontSize="32" FontWeight="Bold"
                           IsVisible="{Binding HasPairingCode}" />
                <TextBlock Text="{Binding PairingExpiryText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
              <WrapPanel Grid.Column="1" ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center">
                <Button Content="Create pairing code" Classes="primary" Command="{Binding GeneratePairingCodeCommand}" />
                <Button Content="Cancel code" Classes="secondary" Command="{Binding CancelPairingCommand}" />
              </WrapPanel>
            </Grid>
          </Border>

          <TextBlock Text="Trusted clients" FontWeight="SemiBold" />
          <ListBox ItemsSource="{Binding PairedClients}" SelectedItem="{Binding SelectedPairedClient, Mode=TwoWay}"
                   MaxHeight="180" Background="Transparent" BorderThickness="0" IsVisible="{Binding HasPairedClients}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#151A20" BorderBrush="#343B45" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,6">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DetailText}" Classes="muted" FontSize="10" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="No native clients are currently paired." Classes="muted" IsVisible="{Binding !HasPairedClients}" />
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="Revoke selected client" Classes="secondary" Command="{Binding RevokeClientCommand}" />
            <Button Content="Revoke every client" Classes="secondary" Command="{Binding RevokeAllClientsCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
          <StackPanel Spacing="3">
            <TextBlock Text="AUTHORITATIVE STORAGE" Classes="eyebrow" />
            <TextBlock Text="RadioVault Server owns this database" FontSize="17" FontWeight="SemiBold" />
          </StackPanel>
          <TextBox Grid.Row="1" Text="{Binding DatabasePath}" IsReadOnly="True" />
          <Button Grid.Row="2" Content="Open data folder" Classes="secondary" Command="{Binding OpenDataFolderCommand}"
                  HorizontalAlignment="Left" />
        </Grid>
      </Border>

      <Border Background="#161A20" BorderBrush="#343B45" BorderThickness="1" CornerRadius="10" Padding="14">
        <TextBlock Text="The server keeps running when this settings window is closed. Every paired native client can be revoked independently without changing the Radio Vault Web private link."
                   Classes="muted" FontSize="11" TextWrapping="Wrap" />
      </Border>

      <Button Content="Save server settings" Classes="primary" Command="{Binding SaveCommand}"
              HorizontalAlignment="Right" MinWidth="190" />
    </StackPanel>
  </ScrollViewer>
</Window>
