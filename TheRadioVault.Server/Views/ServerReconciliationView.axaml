<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheRadioVault.Server.Views.ServerReconciliationView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="26" Spacing="16">
      <StackPanel Spacing="4">
        <TextBlock Text="ARCHIVE RECONCILIATION" Classes="eyebrow" />
        <TextBlock Text="Understand the files before changing them" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="A read-only analysis of broadcasts, recording variants, multipart captures, duplicates and conflicts."
                   Classes="muted" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel Spacing="3">
              <TextBlock Text="RECONCILIATION STATUS" Classes="eyebrow" />
              <TextBlock Text="{Binding ArchiveReconciliationHeadline}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ArchiveReconciliationCompletedText}" Classes="muted" FontSize="10" />
            </StackPanel>
            <Border Grid.Column="1" Background="{Binding ArchiveReconciliationStateBrush}" CornerRadius="999" Padding="13,7" VerticalAlignment="Top">
              <TextBlock Text="{Binding ArchiveReconciliationStateLabel}" Foreground="#101318" FontWeight="Bold" FontSize="10" />
            </Border>
          </Grid>

          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
            <Border Background="#13171D" BorderBrush="#343B45" BorderThickness="1" CornerRadius="9" Padding="12">
              <StackPanel Spacing="3">
                <TextBlock Text="PHYSICAL INVENTORY" Classes="eyebrow" />
                <TextBlock Text="{Binding ArchiveReconciliationInventoryText}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ArchiveReconciliationBroadcastComparisonText}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#13171D" BorderBrush="#343B45" BorderThickness="1" CornerRadius="9" Padding="12">
              <StackPanel Spacing="3">
                <TextBlock Text="FILE INTERPRETATIONS" Classes="eyebrow" />
                <TextBlock Text="{Binding ArchiveReconciliationChangeText}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ArchiveReconciliationFileBreakdownText}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Background="#13171D" BorderBrush="#343B45" BorderThickness="1" CornerRadius="9" Padding="12">
              <StackPanel Spacing="3">
                <TextBlock Text="READINESS" Classes="eyebrow" />
                <TextBlock Text="{Binding ArchiveReconciliationAttentionText}" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Background="#13171D" BorderBrush="#343B45" BorderThickness="1" CornerRadius="9" Padding="12">
              <StackPanel Spacing="3">
                <TextBlock Text="RECORDING EVIDENCE" Classes="eyebrow" />
                <TextBlock Text="{Binding ArchiveReconciliationDuplicateText}" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Background="#13171D" BorderBrush="#343B45" BorderThickness="1" CornerRadius="9" Padding="12">
              <StackPanel Spacing="3">
                <TextBlock Text="IDENTITY STRUCTURE" Classes="eyebrow" />
                <TextBlock Text="{Binding ArchiveReconciliationStructureText}" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Grid.Column="1" Background="#13171D" BorderBrush="#343B45" BorderThickness="1" CornerRadius="9" Padding="12">
              <StackPanel Spacing="3">
                <TextBlock Text="UNRESOLVED EVIDENCE" Classes="eyebrow" />
                <TextBlock Text="{Binding ArchiveReconciliationUnresolvedText}" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Background="#13171D" BorderBrush="#343B45" BorderThickness="1" CornerRadius="10" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding ArchiveReconciliationStatusText}" FontSize="11" TextWrapping="Wrap" />
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding ArchiveReconciliationProgressPercent}"
                           Height="8" Foreground="#F2C94C" Background="#343B45" />
            </StackPanel>
          </Border>
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="Run full reconciliation" Classes="primary" Command="{Binding RunArchiveReconciliationCommand}" />
            <Button Content="Refresh saved status" Classes="secondary" Command="{Binding RefreshArchiveReconciliationCommand}" />
            <Button Content="Export full evidence report…" Classes="secondary" Command="{Binding ExportArchiveReconciliationReportCommand}" />
            <Button Content="Export unresolved-date evidence…" Classes="secondary" Command="{Binding ExportArchiveDateAuthorityEvidenceCommand}"
                    ToolTip.Tip="Small diagnostic export containing only unresolved broadcasts and their historical date evidence." />
            <Button Content="Cancel analysis" Classes="secondary" Command="{Binding CancelArchiveReconciliationCommand}"
                    IsVisible="{Binding IsArchiveReconciliationBusy}" />
          </WrapPanel>
          <TextBlock Text="Reconciliation writes only a shadow index. It does not rename, move, merge or delete media and it does not change the live client library."
                     Classes="muted" FontSize="10" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <StackPanel Spacing="3">
            <TextBlock Text="AUDIT THE DIFFERENCE" Classes="eyebrow" />
            <TextBlock Text="See why the proposed library total changed" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="These are read-only explanations from the shadow index. Nothing listed here has been adopted into the live library."
                       Classes="muted" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>

          <Border Background="#13171D" BorderBrush="#343B45" BorderThickness="1" CornerRadius="10" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="DIFFERENCE BY YEAR" Classes="eyebrow" />
              <TextBlock Text="{Binding ArchiveReconciliationYearDifferenceSummary}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
              <ListBox ItemsSource="{Binding ArchiveReconciliationYearDifferences}" MaxHeight="220">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#2D343E" BorderThickness="0,0,0,1" Padding="4,8">
                      <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{Binding Year}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding DetailDisplay}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{Binding DifferenceDisplay}" Foreground="#F2C94C" FontSize="10" FontWeight="SemiBold" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>

          <TabControl>
            <TabItem Header="Split candidates">
              <StackPanel Spacing="8" Margin="0,10,0,0">
                <TextBlock Text="{Binding ArchiveReconciliationSplitCandidateSummary}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                <ListBox ItemsSource="{Binding ArchiveReconciliationSplitCandidates}" Height="280">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#2D343E" BorderThickness="0,0,0,1" Padding="5,9">
                        <StackPanel Spacing="3">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{Binding Identity}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="#F2C94C" FontSize="10" />
                          </Grid>
                          <TextBlock Text="{Binding Structure}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Reason}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </TabItem>
            <TabItem Header="Review recommended">
              <StackPanel Spacing="8" Margin="0,10,0,0">
                <TextBlock Text="{Binding ArchiveReconciliationReviewSummary}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                <ListBox ItemsSource="{Binding ArchiveReconciliationReviewRecommended}" Height="280">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#2D343E" BorderThickness="0,0,0,1" Padding="5,9">
                        <StackPanel Spacing="3">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{Binding Identity}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="#F2C94C" FontSize="10" />
                          </Grid>
                          <TextBlock Text="{Binding Structure}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Reason}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </TabItem>
            <TabItem Header="Blocked">
              <StackPanel Spacing="8" Margin="0,10,0,0">
                <TextBlock Text="{Binding ArchiveReconciliationBlockedSummary}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                <ListBox ItemsSource="{Binding ArchiveReconciliationBlocked}" Height="280">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#2D343E" BorderThickness="0,0,0,1" Padding="5,9">
                        <StackPanel Spacing="3">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{Binding Identity}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="#E07A7A" FontSize="10" />
                          </Grid>
                          <TextBlock Text="{Binding Structure}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Reason}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </TabItem>
            <TabItem Header="Preserved clips">
              <StackPanel Spacing="8" Margin="0,10,0,0">
                <TextBlock Text="{Binding ArchiveReconciliationPreservedSummary}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                <ListBox ItemsSource="{Binding ArchiveReconciliationPreservedArchiveItems}" Height="280">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#2D343E" BorderThickness="0,0,0,1" Padding="5,9">
                        <StackPanel Spacing="3">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{Binding Identity}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="#66A7D7" FontSize="10" />
                          </Grid>
                          <TextBlock Text="{Binding Structure}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Reason}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </TabItem>
          </TabControl>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <StackPanel Spacing="3">
            <TextBlock Text="SAFE MEDIA CONSOLIDATION" Classes="eyebrow" />
            <TextBlock Text="Build one organised archive without deleting originals" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Radio Vault first reconciles the current physical inventory so every available file is either planned or visibly held. It verifies every planned source with full SHA-256 and chooses the longest recording; equal-length recordings use the highest estimated bitrate. Winners form the managed archive while every moved original—including winners and rejected duplicates—remains in a plan-specific quarantine. Unsafe broadcasts are left untouched."
                       Classes="muted" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
          <Border Background="#241F13" BorderBrush="#E2A84A" BorderThickness="1" CornerRadius="10" Padding="12">
            <TextBlock Text="Radio Vault has no command to delete quarantine media. Preview and rehearsal move nothing. Commit creates a verified database backup first, must be explicitly confirmed, and is available only while the server is stopped."
                       Foreground="#F2C94C" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
          </Border>
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="9">
            <TextBox Text="{Binding ManagedArchivePath}" IsReadOnly="True" PlaceholderText="New managed archive folder" />
            <Button Grid.Column="1" Content="Choose managed folder…" Classes="secondary" Command="{Binding ChooseManagedArchiveCommand}" />
            <TextBox Grid.Row="1" Text="{Binding ConsolidationQuarantinePath}" IsReadOnly="True" PlaceholderText="Separate quarantine folder" />
            <Button Grid.Row="1" Grid.Column="1" Content="Choose quarantine…" Classes="secondary" Command="{Binding ChooseQuarantineCommand}" />
          </Grid>
          <Border Background="#13171D" BorderBrush="#343B45" BorderThickness="1" CornerRadius="10" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding MediaConsolidationPlanText}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Text="{Binding MediaConsolidationStatusText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding MediaConsolidationProgressPercent}"
                           Height="8" Foreground="#F2C94C" Background="#343B45" />
            </StackPanel>
          </Border>
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="1. Prepare preview" Classes="primary" Command="{Binding PrepareMediaConsolidationCommand}" />
            <Button Content="2. Run no-move rehearsal" Classes="secondary" Command="{Binding RehearseMediaConsolidationCommand}" />
            <Button Content="Cancel current step" Classes="secondary" Command="{Binding CancelMediaConsolidationCommand}"
                    IsVisible="{Binding IsMediaConsolidationBusy}" />
          </WrapPanel>
          <StackPanel Spacing="7" IsVisible="{Binding HasPassedMediaConsolidationRehearsal}">
            <TextBlock Text="{Binding MediaConsolidationConfirmationHint}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Text="{Binding ConsolidationConfirmationText, Mode=TwoWay}" PlaceholderText="Exact confirmation phrase" />
              <Button Grid.Column="1" Content="3. Commit consolidation" Classes="primary" Command="{Binding CommitMediaConsolidationCommand}" />
            </Grid>
            <TextBlock Text="Stop the server before commit. A cancelled or interrupted commit can be safely resumed with the same plan; its journal records each verified step."
                       Classes="muted" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
