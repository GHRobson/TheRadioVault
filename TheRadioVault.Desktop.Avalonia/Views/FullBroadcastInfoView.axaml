<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:TheRadioVault.Desktop.Avalonia.Views"
             x:Class="TheRadioVault.Desktop.Avalonia.Views.FullBroadcastInfoView">
  <Grid Margin="{StaticResource RvPagePadding}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Classes="page-scroll-root">
      <StackPanel Spacing="18">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
          <Button Content="← Back" Classes="secondary" Command="{Binding BackCommand}" />
          <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="Play" Classes="primary" Command="{Binding PlayCommand}" />
          <Button Grid.Column="3" Content="⋯" Classes="secondary icon-button" ToolTip.Tip="More actions">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Play next" Command="{Binding PlayNextCommand}" />
                <MenuItem Header="Add to queue" Command="{Binding AddToQueueCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>

        <Border Classes="card" IsVisible="{Binding HasDetails}">
          <Grid ColumnDefinitions="210,*" ColumnSpacing="24">
            <Border Width="210" Height="210" CornerRadius="16"
                    Background="{DynamicResource RvAccentSubtleBrush}" ClipToBounds="True">
              <Grid>
                <ContentControl IsVisible="{Binding !Details.HasArtwork}" Content="Radio mast"
                                ContentTemplate="{StaticResource MissingArtworkIconTemplate}"
                                Width="84" Height="84" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image IsVisible="{Binding Details.HasArtwork}"
                       Source="{Binding Details.ArtworkPath, Converter={StaticResource ArtworkPathToBitmapConverter}}"
                       Stretch="UniformToFill" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
              <TextBlock Text="{Binding Details.CollectionName}" Classes="eyebrow" />
              <TextBlock Text="{Binding Title}" FontSize="31" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DateText}" Classes="muted" FontSize="14" />
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Border Classes="pill" IsVisible="{Binding HasSlot}"><TextBlock Text="{Binding Details.Slot}" FontSize="10" /></Border>
                <Border Classes="pill" IsVisible="{Binding HasStation}"><TextBlock Text="{Binding Details.Station}" FontSize="10" /></Border>
                <Border Classes="pill" IsVisible="{Binding HasEpisodeType}"><TextBlock Text="{Binding Details.EpisodeType}" FontSize="10" /></Border>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="1.25*,*" ColumnSpacing="18" IsVisible="{Binding HasDetails}">
          <StackPanel Spacing="18">
            <Border Classes="card" IsVisible="{Binding HasSummary}">
              <StackPanel Spacing="10">
                <TextBlock Text="Broadcast summary" Classes="section-title" />
                <TextBlock Text="{Binding SummaryText}" Classes="muted" FontSize="13"
                           LineHeight="20" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding HasPeople}">
              <StackPanel Spacing="12">
                <TextBlock Text="People" Classes="section-title" />
                <StackPanel IsVisible="{Binding HasHosts}" Spacing="5">
                  <TextBlock Text="HOSTS" Classes="eyebrow" />
                  <ItemsControl ItemsSource="{Binding HostLinks}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Button Classes="entity-chip" Margin="0,0,5,5" Content="{Binding Label}"
                      Command="{Binding $parent[UserControl].DataContext.RelatedWiki.OpenEntityCommand}" CommandParameter="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel IsVisible="{Binding HasGuests}" Spacing="5">
                  <TextBlock Text="GUESTS" Classes="eyebrow" />
                  <ItemsControl ItemsSource="{Binding GuestLinks}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Button Classes="entity-chip" Margin="0,0,5,5" Content="{Binding Label}"
                      Command="{Binding $parent[UserControl].DataContext.RelatedWiki.OpenEntityCommand}" CommandParameter="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel IsVisible="{Binding HasCallers}" Spacing="5">
                  <TextBlock Text="CALLERS" Classes="eyebrow" />
                  <ItemsControl ItemsSource="{Binding CallerLinks}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Button Classes="entity-chip" Margin="0,0,5,5" Content="{Binding Label}"
                      Command="{Binding $parent[UserControl].DataContext.RelatedWiki.OpenEntityCommand}" CommandParameter="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel IsVisible="{Binding HasMentionedPeople}" Spacing="5">
                  <TextBlock Text="MENTIONED" Classes="eyebrow" />
                  <ItemsControl ItemsSource="{Binding MentionedPeopleLinks}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Button Classes="entity-chip" Margin="0,0,5,5" Content="{Binding Label}"
                      Command="{Binding $parent[UserControl].DataContext.RelatedWiki.OpenEntityCommand}" CommandParameter="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding HasCatalogueDetails}">
              <StackPanel Spacing="10">
                <TextBlock Text="Programme and catalogue details" Classes="section-title" />
                <ItemsControl ItemsSource="{Binding CatalogueFields}">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Grid ColumnDefinitions="150,*" ColumnSpacing="12" Margin="0,0,0,7">
                      <TextBlock Text="{Binding Label}" Classes="muted" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding HasTopics}">
              <StackPanel Spacing="10">
                <TextBlock Text="Topics" Classes="section-title" />
                <ItemsControl ItemsSource="{Binding TopicLinks}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><Button Classes="entity-chip" Margin="0,0,7,7" Content="{Binding Label}"
                      Command="{Binding $parent[UserControl].DataContext.RelatedWiki.OpenEntityCommand}" CommandParameter="{Binding}" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding HasDetails}">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource RvAccentSubtleBrush}">
                    <Path Width="23" Height="23" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Stroke="{DynamicResource RvAccentBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                          Data="M12,3 C9.8,3 8,4.8 8,7 L8,12 C8,14.2 9.8,16 12,16 C14.2,16 16,14.2 16,12 L16,7 C16,4.8 14.2,3 12,3 Z M5,11 C5,15.4 8.1,19 12,19 C15.9,19 19,15.4 19,11 M12,19 L12,22" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="Transcript" Classes="section-title" />
                    <TextBlock Text="{Binding TranscriptStateText}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TranscriptDetailsText}" Classes="subtle" FontSize="9" />
                  </StackPanel>
                  <Button Grid.Column="2" Content="Start transcription" Classes="secondary" IsVisible="{Binding HasNoTranscript}"
                          Command="{Binding StartTranscriptionCommand}" VerticalAlignment="Center" />
                </Grid>
                <Expander Header="Read transcript" IsVisible="{Binding HasTranscript}" IsExpanded="False">
                  <StackPanel Margin="0,10,0,0" Spacing="9">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock Text="Timed phrases" Classes="eyebrow" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Edit in Transcription studio" Classes="ghost" Command="{Binding OpenTranscriptCommand}" />
                    </Grid>
                    <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding TranscriptSegments}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                          <Button Classes="ghost" Command="{Binding $parent[UserControl].DataContext.PlayTranscriptSegmentCommand}"
                                  CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="8,7" Margin="0,0,0,3">
                            <Grid ColumnDefinitions="58,120,*" ColumnSpacing="10">
                              <TextBlock Text="{Binding TimeDisplay}" Foreground="{DynamicResource RvAccentBrush}" FontWeight="SemiBold" FontSize="10" />
                              <TextBlock Grid.Column="1" Text="{Binding DisplaySpeaker}" Classes="subtle" FontSize="10" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" FontSize="11" />
                            </Grid>
                          </Button>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding HasArchiveNotes}">
              <StackPanel Spacing="9">
                <TextBlock Text="Archive notes" Classes="section-title" />
                <TextBlock Text="{Binding Details.ArchiveNotes}" Classes="muted" FontSize="12"
                           LineHeight="19" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="card" IsVisible="{Binding HasPersonalNotes}">
              <StackPanel Spacing="9">
                <TextBlock Text="Personal notes" Classes="section-title" />
                <TextBlock Text="{Binding Details.PersonalNotes}" Classes="muted" FontSize="12"
                           LineHeight="19" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="18">
            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Metadata" Classes="section-title" />
                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                  <TextBlock Text="Station" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding Details.Station}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Text="Edition" Classes="muted" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Details.Edition}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="2" Text="Variant" Classes="muted" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Details.BroadcastVariant}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="3" Text="Era" Classes="muted" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Details.BroadcastEra}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="4" Text="Episode type" Classes="muted" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Details.EpisodeType}" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
            </Border>

            <Expander Header="Technical archive details" IsExpanded="False">
              <Border Classes="card" Margin="0,8,0,0">
                <StackPanel Spacing="12">
                  <TextBlock Text="These identifiers are useful for diagnostics, reconciliation and support." Classes="muted" FontSize="10" TextWrapping="Wrap" />
                  <StackPanel Spacing="4">
                    <TextBlock Text="Canonical identity" Classes="eyebrow" />
                    <TextBlock Text="{Binding Details.CanonicalKey}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Classes="muted" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Broadcast UID" Classes="eyebrow" />
                    <TextBlock Text="{Binding Details.BroadcastId}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Classes="muted" />
                  </StackPanel>
                  <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                    <TextBlock Text="Collection" Classes="muted" />
                    <TextBlock Grid.Column="1" Text="{Binding Details.CollectionName}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="Media structure" Classes="muted" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Details.MediaStructureText}" TextWrapping="Wrap" />
                  </Grid>
                </StackPanel>
              </Border>
            </Expander>
          </StackPanel>
        </Grid>

        <Border Classes="card" IsVisible="{Binding !HasDetails}" Padding="40">
          <StackPanel HorizontalAlignment="Center" Spacing="8">
            <TextBlock Text="Broadcast information unavailable" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusText}" Classes="muted" TextAlignment="Center" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
