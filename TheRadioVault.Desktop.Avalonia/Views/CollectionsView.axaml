<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheRadioVault.Desktop.Avalonia.Views.CollectionsView">
  <Grid Margin="28,16,28,28" RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <Border Classes="card" Padding="14">
      <Grid ColumnDefinitions="1.25*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBox Classes="search-box" Text="{Binding NewName, Mode=TwoWay}"
                 PlaceholderText="Name a playlist or smart collection" />
        <Button Grid.Column="1" Content="New playlist" Classes="secondary"
                Command="{Binding CreatePlaylistCommand}" />
        <Button Grid.Column="2" Content="Save Up Next" Classes="secondary"
                Command="{Binding SaveQueueCommand}" />
        <Button Grid.Column="3" Content="Refresh" Classes="ghost"
                Command="{Binding RefreshCommand}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="card" Padding="14">
      <Grid ColumnDefinitions="Auto,220,*,Auto" ColumnSpacing="10">
        <TextBlock Text="Smart collection" FontWeight="SemiBold" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding SmartFilters}"
                  SelectedItem="{Binding SelectedSmartFilter, Mode=TwoWay}">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox Grid.Column="2" Classes="search-box" Text="{Binding SmartSearchText, Mode=TwoWay}"
                 PlaceholderText="Optional words, people, topics or title" />
        <Button Grid.Column="3" Content="Create smart collection" Classes="primary"
                Command="{Binding CreateSmartCollectionCommand}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="300,*" ColumnSpacing="16">
      <Border Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Margin="14,12" Text="{Binding StatusText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
          <ListBox Grid.Row="1" Margin="8" ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedCollection, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="12,10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding KindText}" Classes="muted" FontSize="10" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="subtle" FontSize="9"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card" Padding="0">
        <Grid>
          <Grid IsVisible="{Binding HasSelection}" RowDefinitions="Auto,*">
            <Border Padding="16,13" Background="{DynamicResource RvSurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource RvBorderBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Details.Summary.Name}" FontSize="18" FontWeight="Bold" />
                  <TextBlock Text="{Binding SelectedKindText}" Classes="muted" FontSize="10" />
                </StackPanel>
                <Button Grid.Column="1" IsVisible="{Binding IsManual}" Content="Add current broadcast"
                        Classes="secondary" Command="{Binding AddCurrentBroadcastCommand}" />
                <Button Grid.Column="2" IsVisible="{Binding IsManual}" Content="Remove selected"
                        Classes="secondary" Command="{Binding RemoveBroadcastCommand}" />
                <Button Grid.Column="3" Content="Delete collection" Classes="ghost"
                        Command="{Binding DeleteCommand}" />
              </Grid>
            </Border>
            <ListBox Grid.Row="1" Margin="8" ItemsSource="{Binding Broadcasts}"
                     SelectedItem="{Binding SelectedBroadcast, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="12,10">
                    <Grid ColumnDefinitions="90,*,90" ColumnSpacing="12">
                      <TextBlock Text="{Binding DateText}" Classes="muted" FontSize="10" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CollectionText}" Classes="muted" FontSize="10" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CompactProgressText}" Classes="subtle" FontSize="10" VerticalAlignment="Center" />
                        <Button Content="▶" Classes="ghost icon-button" Command="{Binding PlayCommand}" ToolTip.Tip="Play broadcast" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <StackPanel IsVisible="{Binding !HasSelection}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock Text="Create or select a collection" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Playlists keep your chosen order. Smart collections update from saved Library rules."
                       Classes="muted" FontSize="11" TextAlignment="Center" MaxWidth="440" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
