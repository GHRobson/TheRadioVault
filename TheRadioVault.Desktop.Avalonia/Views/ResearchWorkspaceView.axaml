<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:TheRadioVault.Desktop.Avalonia.Views"
             x:Class="TheRadioVault.Desktop.Avalonia.Views.ResearchWorkspaceView">
  <UserControl.Styles>
    <Style Selector="Border.coverage-cell">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.coverage-cell.weekend"><Setter Property="Background" Value="{DynamicResource RvSurfaceRaisedBrush}" /></Style>
    <Style Selector="Border.coverage-cell.gap"><Setter Property="Background" Value="{DynamicResource RvDangerSubtleBrush}" /></Style>
    <Style Selector="Border.coverage-cell.missing"><Setter Property="Background" Value="{DynamicResource RvDangerBrush}" /></Style>
    <Style Selector="Border.coverage-cell.critical"><Setter Property="Background" Value="{DynamicResource RvWarningSubtleBrush}" /></Style>
    <Style Selector="Border.coverage-cell.sparse"><Setter Property="Background" Value="{DynamicResource RvWarningBrush}" /></Style>
    <Style Selector="Border.coverage-cell.partial"><Setter Property="Background" Value="{DynamicResource RvAccentMutedBrush}" /></Style>
    <Style Selector="Border.coverage-cell.complete"><Setter Property="Background" Value="{DynamicResource RvSuccessBrush}" /></Style>
  </UserControl.Styles>
  <Grid Margin="{StaticResource RvPagePadding}" RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="3">
        <TextBlock Text="Knowledge" Classes="display-title" />
        <TextBlock Text="Evidence, provenance and protected metadata editing for the archive." Classes="muted" FontSize="12" />
        <TextBlock Text="{Binding WorkspaceCountText}" Classes="subtle" FontSize="10" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="secondary" Command="{Binding ChooseImportCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Text="{Binding ChooseImportButtonText}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Content="Export full Knowledge Database…" Classes="secondary" Command="{Binding ExportCommand}"
                IsEnabled="{Binding IsPackTransferAvailable}" />
        <Button Content="Refresh" Classes="ghost" Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ToggleButton Content="Overview" Classes="secondary" Command="{Binding ShowDashboardCommand}" IsChecked="{Binding IsDashboardMode, Mode=OneWay}" />
        <ToggleButton Content="Knowledge records" Classes="secondary" Command="{Binding ShowRecordsCommand}" IsChecked="{Binding IsRecordsMode, Mode=OneWay}" />
        <ToggleButton Content="Date review" Classes="secondary" Command="{Binding ShowDateReviewCommand}" IsChecked="{Binding IsDateReviewMode, Mode=OneWay}" />
        <ToggleButton Content="Undated broadcasts" Classes="secondary" Command="{Binding ShowUndatedCommand}" IsChecked="{Binding IsUndatedMode, Mode=OneWay}" />
        <ToggleButton Content="Coverage heatmap" Classes="secondary" Command="{Binding ShowCoverageCommand}" IsChecked="{Binding IsCoverageMode, Mode=OneWay}" />
        <Button Content="Transcription studio" Classes="secondary" Command="{Binding OpenTranscriptionCommand}" />
      </StackPanel>
      <Border Classes="card-raised" IsVisible="{Binding IsImportBusy}" Padding="12"
              Background="{DynamicResource RvSurfaceRaisedBrush}" BorderBrush="{DynamicResource RvAccentBrush}">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <TextBlock Text="{Binding ImportProgressText}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" Text="{Binding ImportProgressCountText}" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding ImportProgressPercentText}" FontWeight="Bold"
                       Foreground="{DynamicResource RvAccentBrush}" VerticalAlignment="Center" />
          </Grid>
          <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding ImportProgressPercent}"
                       Height="8" Foreground="{DynamicResource RvAccentBrush}"
                       Background="{DynamicResource RvBorderBrush}" />
        </Grid>
      </Border>
      <Border Classes="card" Padding="12" IsVisible="{Binding IsRecordsMode}">
        <Grid ColumnDefinitions="2*,190,180,Auto" ColumnSpacing="9">
          <TextBox Classes="search-box" Text="{Binding SearchText, Mode=TwoWay}"
                   PlaceholderText="Search summaries, people, topics or dates" />
          <ComboBox Grid.Column="1" Classes="filter-box" ItemsSource="{Binding Collections}"
                    SelectedItem="{Binding SelectedCollection, Mode=TwoWay}">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Grid.Column="2" Classes="filter-box" ItemsSource="{Binding Statuses}"
                    SelectedItem="{Binding SelectedStatus, Mode=TwoWay}">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="3" Content="Reset" Classes="ghost" Command="{Binding ClearFiltersCommand}"
                  IsVisible="{Binding HasActiveFilters}" />
        </Grid>
      </Border>

      <Border IsVisible="{Binding HasPendingImport}" Classes="card-raised"
              Background="{DynamicResource RvAccentSubtleBrush}" BorderBrush="{DynamicResource RvAccentBrush}" Padding="12">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <StackPanel Spacing="3">
            <TextBlock Text="Archive Knowledge Database ready" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ImportPreviewText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <TextBlock IsVisible="{Binding IsAuthoritativeImport}" Text="{Binding ImportModeText}" FontSize="10" TextWrapping="Wrap"
                       Foreground="{DynamicResource RvWarningBrush}" />
            <TextBlock IsVisible="{Binding !IsAuthoritativeImport}" Text="{Binding ResearchTransferOwnershipText}"
                       Classes="muted" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Content="Cancel" Classes="ghost" Command="{Binding CancelImportCommand}" />
          <Button Grid.Column="2" Classes="primary" Command="{Binding ApplyImportCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Text="{Binding ApplyImportButtonText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
      <Border IsVisible="{Binding HasImportError}" Classes="card-raised"
              Background="{DynamicResource RvDangerSubtleBrush}" BorderBrush="{DynamicResource RvDangerBrush}" Padding="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="3">
            <TextBlock Text="This Knowledge import could not finish" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedImportFileText}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ImportErrorText}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource RvDangerBrush}" />
            <TextBlock Text="No partial changes were kept. Correct the problem or choose another database, then try again."
                       Classes="muted" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Content="Try again" Classes="secondary" Command="{Binding RetryImportCommand}"
                  VerticalAlignment="Center" />
        </Grid>
      </Border>
    </StackPanel>

    <ScrollViewer Grid.Row="2" IsVisible="{Binding IsDashboardMode}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16" MaxWidth="1180" HorizontalAlignment="Center" Margin="4,0,4,20">
        <Border Classes="card-raised" Padding="24">
          <Grid ColumnDefinitions="1.4*,1*" ColumnSpacing="28">
            <StackPanel Spacing="8">
              <TextBlock Text="Archive Knowledge Database" Classes="eyebrow" />
              <TextBlock Text="What Radio Vault knows" FontSize="29" FontWeight="Bold" />
              <TextBlock Text="{Binding Overview.KnowledgeStateText}" Classes="muted" FontSize="14"
                         TextWrapping="Wrap" LineHeight="21" />
              <TextBlock Text="Knowledge records, Explore articles, citations, transcripts and archive links are carried together in one portable database."
                         Classes="subtle" FontSize="10" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                <Button Content="Review knowledge" Classes="primary" Command="{Binding ShowRecordsCommand}" />
                <Button Content="Check dates" Classes="secondary" Command="{Binding ShowDateReviewCommand}" />
                <Button Content="Coverage map" Classes="ghost" Command="{Binding ShowCoverageCommand}" />
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Classes="card" Padding="18" VerticalAlignment="Center">
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                <StackPanel Spacing="2">
                  <TextBlock Text="CORE COVERAGE" Classes="eyebrow" />
                  <TextBlock Text="{Binding KnowledgeCoverageText}" FontSize="29" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="ARCHIVE RANGE" Classes="eyebrow" />
                  <TextBlock Text="{Binding KnowledgeDateRangeText}" FontSize="24" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="2">
                  <TextBlock Text="SHOWS" Classes="eyebrow" />
                  <TextBlock Text="{Binding KnowledgeShowsText}" FontSize="24" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                  <TextBlock Text="NEEDS ATTENTION" Classes="eyebrow" />
                  <TextBlock Text="{Binding KnowledgeAttentionText}" FontSize="24" FontWeight="Bold" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
          <Border Classes="card" Padding="18">
            <StackPanel Spacing="5">
              <TextBlock Text="Knowledge records" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Overview.TotalText}" FontSize="30" FontWeight="Bold" />
              <TextBlock Text="{Binding Overview.InLibraryText, StringFormat={}{0} linked to playable broadcasts}" Classes="muted" FontSize="10" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" Padding="18">
            <StackPanel Spacing="5">
              <TextBlock Text="Summaries" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{Binding KnowledgeSummariesText}" FontSize="30" FontWeight="Bold" />
              <ProgressBar Classes="thin" Value="{Binding SummaryCoveragePercent}" Maximum="100" />
              <TextBlock Text="Broadcasts with usable contextual summaries" Classes="muted" FontSize="10" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card" Padding="18">
            <StackPanel Spacing="5">
              <TextBlock Text="Sourced records" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{Binding KnowledgeSourcesText}" FontSize="30" FontWeight="Bold" />
              <ProgressBar Classes="thin" Value="{Binding SourceCoveragePercent}" Maximum="100" />
              <TextBlock Text="{Binding Overview.LastImportText}" Classes="muted" FontSize="10" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="1.25*,1*" ColumnSpacing="14">
          <Border Classes="card-raised" Padding="20">
            <StackPanel Spacing="12">
              <TextBlock Text="Knowledge coverage" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="How consistently the core descriptive fields are populated across the archive." Classes="muted" FontSize="10" />
              <Grid ColumnDefinitions="105,*,52" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="11">
                <TextBlock Text="Summaries" Classes="muted" /><ProgressBar Grid.Column="1" Classes="thin" Value="{Binding SummaryCoveragePercent}" Maximum="100" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Overview.WithSummaries}" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="1" Text="People" Classes="muted" /><ProgressBar Grid.Row="1" Grid.Column="1" Classes="thin" Value="{Binding PeopleCoveragePercent}" Maximum="100" VerticalAlignment="Center" /><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Overview.WithPeople}" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="2" Text="Topics" Classes="muted" /><ProgressBar Grid.Row="2" Grid.Column="1" Classes="thin" Value="{Binding TopicCoveragePercent}" Maximum="100" VerticalAlignment="Center" /><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Overview.WithTopics}" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="3" Text="Sources" Classes="muted" /><ProgressBar Grid.Row="3" Grid.Column="1" Classes="thin" Value="{Binding SourceCoveragePercent}" Maximum="100" VerticalAlignment="Center" /><TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Overview.WithSources}" HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" Padding="20">
            <StackPanel Spacing="11">
              <TextBlock Text="Work queues" FontSize="20" FontWeight="SemiBold" />
              <Button Classes="secondary" HorizontalContentAlignment="Stretch" Command="{Binding ShowRecordsCommand}">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Research needing attention" /><TextBlock Grid.Column="1" Text="{Binding KnowledgeAttentionText}" FontWeight="Bold" /></Grid>
              </Button>
              <Button Classes="secondary" HorizontalContentAlignment="Stretch" Command="{Binding ShowUndatedCommand}">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Undated broadcasts" /><TextBlock Grid.Column="1" Text="Review" Foreground="{DynamicResource RvAccentBrush}" /></Grid>
              </Button>
              <Button Classes="secondary" HorizontalContentAlignment="Stretch" Command="{Binding OpenTranscriptionCommand}">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Transcription studio" /><TextBlock Grid.Column="1" Text="Open" Foreground="{DynamicResource RvAccentBrush}" /></Grid>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" ColumnDefinitions="0.8*,6,1.5*" IsVisible="{Binding IsRecordsMode}">
      <Border MinWidth="300" BorderBrush="{DynamicResource RvBorderBrush}" BorderThickness="1" CornerRadius="12"
              Background="{DynamicResource RvSurfaceBrush}" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <Border Padding="14,11" BorderBrush="{DynamicResource RvBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding BrowseHeading}" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Text="{Binding BrowseDescription}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Classes="accent-pill" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="{Binding Overview.CoverageText}" FontWeight="Bold"
                             Foreground="{DynamicResource RvAccentMutedBrush}" />
                  <TextBlock Text="coverage" Classes="muted" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                     IsVisible="{Binding HasRecords}" Classes="research-list" Margin="6">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="12,10" BorderBrush="{DynamicResource RvBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding HeadlineText}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   MaxLines="2" />
                        <TextBlock Text="{Binding ShowName}" Classes="muted" FontSize="10" />
                        <TextBlock Text="{Binding DateText}" Classes="subtle" FontSize="10" />
                        <TextBlock Text="{Binding EvidenceText}" Classes="subtle" FontSize="9" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="5">
                        <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="{DynamicResource RvAccentBrush}" />
                        <TextBlock Text="{Binding ConfidenceText}" Classes="muted" FontSize="10" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{Binding ShowAttentionEmptyState}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="360" Margin="28" Spacing="9">
              <Border Width="54" Height="54" CornerRadius="17" Background="{DynamicResource RvSuccessSubtleBrush}">
                <Path Data="M4,11 L9,16 L20,5" Width="25" Height="25" Stretch="Uniform"
                      Stroke="{DynamicResource RvSuccessBrush}" StrokeThickness="2.5"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Everything is up to date" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="Radio Vault has no ambiguous matches, review flags or unresolved metadata conflicts waiting for you."
                         Classes="muted" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" />
              <Button Content="Browse all research" Classes="secondary" HorizontalAlignment="Center"
                      Command="{Binding ShowAllResearchCommand}" />
            </StackPanel>
            <StackPanel IsVisible="{Binding ShowFilteredEmptyState}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="28" Spacing="7">
              <TextBlock Text="No matching research" FontWeight="SemiBold" FontSize="16" />
              <TextBlock Text="Try another show, status or search term." Classes="muted" FontSize="11" />
              <Button Content="Reset filters" Classes="secondary" Command="{Binding ClearFiltersCommand}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" Background="Transparent" />

      <Border Grid.Column="2" MinWidth="480" BorderBrush="{DynamicResource RvBorderBrush}" BorderThickness="1" CornerRadius="12"
              Background="{DynamicResource RvSurfaceBrush}" ClipToBounds="True">
        <Grid>
          <StackPanel IsVisible="{Binding !HasSelection}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
            <TextBlock Text="Choose a research record" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Its metadata, people and evidence will appear here." Classes="muted" />
          </StackPanel>

          <Grid IsVisible="{Binding HasSelection}" RowDefinitions="Auto,*">
            <Border Padding="16,12" BorderBrush="{DynamicResource RvBorderBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding SelectionTitle}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SelectionIdentity}" Classes="muted" FontSize="10" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <Button Content="Play" Classes="secondary" Command="{Binding PlayCommand}" />
                  <Button Content="{Binding ReviewButtonText}" Classes="ghost" Command="{Binding ToggleReviewCommand}" />
                  <Button Content="Save" Classes="primary" Command="{Binding SaveCommand}" />
                </StackPanel>
              </Grid>
            </Border>

            <TabControl Grid.Row="1">
              <TabItem Header="Metadata">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="16" Spacing="12">
                    <Grid ColumnDefinitions="120,*" ColumnSpacing="14">
                      <StackPanel Spacing="7">
                        <Border Width="120" Height="120" CornerRadius="10" Background="{DynamicResource RvAccentSubtleBrush}" ClipToBounds="True">
                          <Grid>
                            <ContentControl IsVisible="{Binding !HasArtwork}" Content="Radio mast"
                                            ContentTemplate="{StaticResource MissingArtworkIconTemplate}"
                                            Width="58" Height="58" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding EditorArtworkPath, Converter={StaticResource ArtworkPathToBitmapConverter}}"
                                   Stretch="UniformToFill" IsVisible="{Binding HasArtwork}" />
                          </Grid>
                        </Border>
                        <Button Content="Choose artwork" Classes="ghost" Command="{Binding ChooseArtworkCommand}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="9">
                        <TextBox Classes="search-box" Text="{Binding EditorHeadline, Mode=TwoWay}" PlaceholderText="Headline" />
                        <TextBox Classes="search-box" Text="{Binding EditorSummary, Mode=TwoWay}" PlaceholderText="Summary"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="106" />
                      </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="9">
                      <TextBox Classes="search-box" Text="{Binding EditorHosts, Mode=TwoWay}" PlaceholderText="Hosts" />
                      <TextBox Grid.Column="1" Classes="search-box" Text="{Binding EditorGuests, Mode=TwoWay}" PlaceholderText="Guests" />
                      <TextBox Grid.Row="1" Classes="search-box" Text="{Binding EditorCallers, Mode=TwoWay}" PlaceholderText="Callers" />
                      <TextBox Grid.Row="1" Grid.Column="1" Classes="search-box" Text="{Binding EditorMentionedPeople, Mode=TwoWay}" PlaceholderText="Mentioned people" />
                    </Grid>
                    <TextBox Classes="search-box" Text="{Binding EditorTopics, Mode=TwoWay}" PlaceholderText="Topics" />

                    <Border Classes="card-raised" Padding="12" IsVisible="{Binding IsCatalogueResearch}">
                      <StackPanel Spacing="10">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding CataloguePanelTitle}" Classes="section-title" />
                          <TextBlock Text="{Binding CataloguePanelHelpText}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="9" RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                          <StackPanel Spacing="4"><TextBlock Text="SERIES" Classes="eyebrow" /><TextBox Classes="search-box" Text="{Binding EditorCatalogueSeries, Mode=TwoWay}" PlaceholderText="Series or collection" /></StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="PROGRAMME / STRAND" Classes="eyebrow" /><TextBox Classes="search-box" Text="{Binding EditorCatalogueProgramme, Mode=TwoWay}" PlaceholderText="Town Hall, Unmasked…" /></StackPanel>
                          <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="FORMAT" Classes="eyebrow" /><TextBox Classes="search-box" Text="{Binding EditorCatalogueFormat, Mode=TwoWay}" PlaceholderText="Interview, panel, special…" /></StackPanel>
                          <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="ORIGINAL RELEASE" Classes="eyebrow" /><TextBox Classes="search-box" Text="{Binding EditorOriginalReleaseDate, Mode=TwoWay}" PlaceholderText="Exact or partial date" /></StackPanel>
                          <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="RECORDED" Classes="eyebrow" /><TextBox Classes="search-box" Text="{Binding EditorRecordingDate, Mode=TwoWay}" PlaceholderText="Recording date" /></StackPanel>
                          <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4"><TextBlock Text="NETWORK / PLATFORM" Classes="eyebrow" /><TextBox Classes="search-box" Text="{Binding EditorNetwork, Mode=TwoWay}" PlaceholderText="SiriusXM, XM, web…" /></StackPanel>
                          <StackPanel Grid.Row="2" Spacing="4"><TextBlock Text="VENUE" Classes="eyebrow" /><TextBox Classes="search-box" Text="{Binding EditorVenue, Mode=TwoWay}" PlaceholderText="Studio or venue" /></StackPanel>
                          <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4"><TextBlock Text="EVENT" Classes="eyebrow" /><TextBox Classes="search-box" Text="{Binding EditorEvent, Mode=TwoWay}" PlaceholderText="Festival, premiere, live event…" /></StackPanel>
                          <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4"><TextBlock Text="CATALOGUE NUMBER" Classes="eyebrow" /><TextBox Classes="search-box" Text="{Binding EditorCatalogueNumber, Mode=TwoWay}" PlaceholderText="Archive or source identifier" /></StackPanel>
                        </Grid>
                        <StackPanel Spacing="4"><TextBlock Text="ORIGINAL FILENAME" Classes="eyebrow" /><TextBox Classes="search-box" Text="{Binding EditorOriginalFilename, Mode=TwoWay}" PlaceholderText="Original archive filename" /></StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                          <StackPanel Spacing="4"><TextBlock Text="PROVENANCE" Classes="eyebrow" /><TextBox Classes="search-box" Text="{Binding EditorProvenance, Mode=TwoWay}" PlaceholderText="Where this recording or identification came from" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" /></StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="RESEARCH NOTES" Classes="eyebrow" /><TextBox Classes="search-box" Text="{Binding EditorResearchNotes, Mode=TwoWay}" PlaceholderText="Uncertainty, alternate titles and follow-up notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" /></StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <TextBox Classes="search-box" Text="{Binding EditorArchiveNotes, Mode=TwoWay}" PlaceholderText="Archive notes"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="78" />

                    <Expander Header="Advanced metadata" IsExpanded="False">
                      <StackPanel Margin="0,9,0,0" Spacing="9">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="9" RowDefinitions="Auto,Auto" RowSpacing="9">
                          <TextBox Classes="search-box" Text="{Binding EditorStation, Mode=TwoWay}" PlaceholderText="Station" IsEnabled="{Binding CanEditAdvancedMetadata}" />
                          <TextBox Grid.Column="1" Classes="search-box" Text="{Binding EditorEdition, Mode=TwoWay}" PlaceholderText="Edition" />
                          <TextBox Grid.Column="2" Classes="search-box" Text="{Binding EditorEpisodeType, Mode=TwoWay}" PlaceholderText="Episode type" IsEnabled="{Binding CanEditAdvancedMetadata}" />
                          <TextBox Grid.Row="1" Classes="search-box" Text="{Binding EditorVariant, Mode=TwoWay}" PlaceholderText="Broadcast variant" IsEnabled="{Binding CanEditAdvancedMetadata}" />
                          <TextBox Grid.Row="1" Grid.Column="1" Classes="search-box" Text="{Binding EditorEra, Mode=TwoWay}" PlaceholderText="Broadcast era" IsEnabled="{Binding CanEditAdvancedMetadata}" />
                          <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,46" ColumnSpacing="6">
                            <Slider Minimum="0" Maximum="100" Value="{Binding EditorConfidence, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding EditorConfidenceText}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          </Grid>
                        </Grid>
                        <TextBox Classes="search-box" Text="{Binding EditorConfidenceReason, Mode=TwoWay}" PlaceholderText="Confidence reason" />
                        <CheckBox Content="Needs review" IsChecked="{Binding EditorNeedsReview, Mode=TwoWay}" IsEnabled="{Binding CanEditReviewState}" />
                      </StackPanel>
                    </Expander>
                    <TextBlock Text="{Binding MetadataOwnershipHelpText}" Classes="subtle" FontSize="10" TextWrapping="Wrap" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Sources">
                <Grid Margin="14" RowDefinitions="Auto,*" RowSpacing="9">
                  <Button Content="Open selected source" Classes="secondary" HorizontalAlignment="Left" Command="{Binding OpenSourceCommand}" />
                  <Grid Grid.Row="1">
                    <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                             IsVisible="{Binding HasSources}" Background="Transparent" BorderThickness="0">
                      <ListBox.ItemTemplate><DataTemplate>
                        <Border Padding="10,8" BorderBrush="{DynamicResource RvBorderBrush}" BorderThickness="0,0,0,1">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailText}" Classes="muted" FontSize="10" />
                            <TextBlock Text="{Binding Supports}" Classes="subtle" FontSize="10" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No sources saved for this record." Classes="muted" IsVisible="{Binding !HasSources}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </Grid>
              </TabItem>

              <TabItem Header="Diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="14" Spacing="14">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Source diagnostics" Classes="section-title" />
                      <ItemsControl ItemsSource="{Binding SourceDiagnostics}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                          <Border Padding="10,8" BorderBrush="{DynamicResource RvBorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding SourceTypeText}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding CountText}" Classes="muted" FontSize="10" />
                              <TextBlock Text="{Binding QualityText}" Classes="subtle" FontSize="9" />
                            </StackPanel>
                          </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="6">
                      <TextBlock Text="Import history" Classes="section-title" />
                      <ItemsControl ItemsSource="{Binding ImportHistory}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                          <Border Padding="10,8" BorderBrush="{DynamicResource RvBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ResultText}" Classes="muted" FontSize="10" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="{Binding ImportedText}" Classes="subtle" FontSize="9" />
                            </Grid>
                          </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" IsVisible="{Binding IsDateReviewMode}" ColumnDefinitions="1.08*,0.92*" ColumnSpacing="14">
      <Border Classes="card" Padding="0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <Border Padding="14,12" BorderBrush="{DynamicResource RvBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,220" ColumnSpacing="10">
              <StackPanel Spacing="3">
                <TextBlock Text="Broadcast date decisions" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Missing, uncertain or conflicting dates from every show that need a human decision before changing Library chronology." Classes="muted" FontSize="10" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                  <ToggleButton Content="{Binding ActiveDateReviewLabel}" IsChecked="{Binding IsActiveDateReviewQueue, Mode=OneWay}" Command="{Binding ShowActiveDateReviewsCommand}" Classes="secondary" FontSize="10" />
                  <ToggleButton Content="{Binding IgnoredDateReviewLabel}" IsChecked="{Binding IsIgnoredDateReviewQueue, Mode=OneWay}" Command="{Binding ShowIgnoredDateReviewsCommand}" Classes="secondary" FontSize="10" />
                  <ToggleButton Content="{Binding CompletedDateReviewLabel}" IsChecked="{Binding IsCompletedDateReviewQueue, Mode=OneWay}" Command="{Binding ShowCompletedDateReviewsCommand}" Classes="secondary" FontSize="10" />
                  <Button Content="{Binding UndoDateDecisionText}" IsVisible="{Binding CanUndoDateDecision}" Command="{Binding UndoDateDecisionCommand}" Classes="ghost" FontSize="10" />
                </StackPanel>
              </StackPanel>
              <ComboBox Grid.Column="1" Classes="filter-box" ItemsSource="{Binding Collections}"
                        SelectedItem="{Binding SelectedCollection, Mode=TwoWay}" VerticalAlignment="Center">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding DateReviews}" SelectedItem="{Binding SelectedDateReview, Mode=TwoWay}"
                     IsVisible="{Binding HasDateReviews}" Margin="6" Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate><DataTemplate>
                <Border Padding="12,10" BorderBrush="{DynamicResource RvBorderBrush}" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3" MinWidth="0">
                      <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding ShowName}" Classes="muted" FontSize="10" />
                      <TextBlock Text="{Binding OriginalFilename}" Classes="subtle" FontSize="9" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding EvidenceText}" Classes="subtle" FontSize="9" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding ProposedDateText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding DecisionText}" FontSize="9" Foreground="{DynamicResource RvAccentBrush}" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding CollisionText}" IsVisible="{Binding HasSameDayCollision}" FontSize="9"
                                 Foreground="{DynamicResource RvWarningBrush}" MaxWidth="210" TextWrapping="Wrap" TextAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{Binding !HasDateReviews}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24">
              <Border Width="54" Height="54" CornerRadius="17" Background="{DynamicResource RvSuccessSubtleBrush}">
                <Path Data="M4,11 L9,16 L20,5" Width="25" Height="25" Stretch="Uniform"
                      Stroke="{DynamicResource RvSuccessBrush}" StrokeThickness="2.5" StrokeLineCap="Round" StrokeJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{Binding DateReviewEmptyTitle}" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DateReviewEmptyHelp}" Classes="muted" FontSize="10" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card" Padding="18">
        <Grid>
          <StackPanel IsVisible="{Binding !HasDateReviewSelection}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
            <ContentControl Content="Radio mast" ContentTemplate="{StaticResource MissingArtworkIconTemplate}" Width="54" Height="54" />
            <TextBlock Text="Choose a date decision" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Evidence and approval choices will appear here." Classes="muted" FontSize="10" TextAlignment="Center" />
          </StackPanel>
          <ScrollViewer IsVisible="{Binding HasDateReviewSelection}" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="15">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding SelectedDateReview.DisplayTitle}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedDateReview.ShowName}" Classes="muted" />
                <TextBlock Text="{Binding SelectedDateReview.OriginalFilename}" Classes="subtle" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>

              <Border Classes="card-raised" Padding="12">
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Proposed date" Classes="eyebrow" />
                      <TextBlock Text="{Binding SelectedDateReview.ProposedDateText}" FontSize="18" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding SelectedDateReview.CandidateKind}" Classes="muted" FontSize="10" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="accent-pill" VerticalAlignment="Top">
                      <TextBlock Text="{Binding SelectedDateReview.DecisionText}" FontSize="9" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding SelectedDateReview.Basis}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SelectedDateReview.Provenance}" Classes="subtle" FontSize="9" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SelectedDateReview.CollisionText}" IsVisible="{Binding SelectedDateReview.HasSameDayCollision}"
                             Foreground="{DynamicResource RvWarningBrush}" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Spacing="4">
                  <TextBlock Text="ORIGINAL RELEASE / ARCHIVE" Classes="eyebrow" />
                  <TextBlock Text="{Binding SelectedDateReview.ReleaseDateText}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="RECORDING / EVENT" Classes="eyebrow" />
                  <TextBlock Text="{Binding SelectedDateReview.RecordingDateText}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>

              <Border Classes="card-raised" Padding="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="CURRENT LIBRARY DATE" Classes="eyebrow" />
                  <TextBlock Text="{Binding SelectedDateReview.CurrentLibraryDateText}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedDateReview.CurrentDateWarningText}"
                             IsVisible="{Binding SelectedDateReview.WouldReplaceCurrentLibraryDate}"
                             Foreground="{DynamicResource RvWarningBrush}" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <StackPanel IsVisible="{Binding SelectedDateReview.IsPending}" Spacing="8">
                <TextBlock Text="Library date decision" Classes="section-title" />
                <DatePicker SelectedDate="{Binding SelectedDateReviewDate, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding DateReviewActionHelpText}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                  <Button Content="Approve  (A)" Classes="primary" Command="{Binding ApproveDateCommand}" />
                  <Button Grid.Column="1" Content="Keep existing  (K)" Classes="secondary" Command="{Binding KeepExistingDateCommand}" />
                  <Button Grid.Column="2" Content="Ignore  (I)" Classes="ghost" Command="{Binding IgnoreDateCommand}" />
                </Grid>
                <TextBlock Text="A approve  ·  K keep existing  ·  I ignore  ·  Ctrl+Z undo" Classes="subtle" FontSize="9" />
                <Expander Header="More date choices">
                  <StackPanel Spacing="8" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                      <Button Content="Keep as recording date" Classes="secondary" Command="{Binding KeepRecordingDateCommand}" />
                      <Button Grid.Column="1" Content="Keep as release/archive date" Classes="secondary" Command="{Binding KeepReleaseDateCommand}" />
                    </Grid>
                    <Button Content="Leave Library item undated" Classes="ghost" Command="{Binding LeaveUndatedCommand}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Expander>
              </StackPanel>
              <StackPanel IsVisible="{Binding SelectedDateReview.IsResolved}" Spacing="8">
                <TextBlock Text="{Binding DateReviewActionHelpText}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                <Button Content="Return to Active" Classes="secondary" Command="{Binding ReopenDateDecisionCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" IsVisible="{Binding IsUndatedMode}" ColumnDefinitions="1.15*,0.85*" ColumnSpacing="14">
      <Border Classes="card" Padding="0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <Border Padding="14,12" BorderBrush="{DynamicResource RvBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,230" ColumnSpacing="10">
              <StackPanel Spacing="3">
                <TextBlock Text="Undated broadcasts" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Audio that the parser could not assign a reliable broadcast date." Classes="muted" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
              <ComboBox Grid.Column="1" Classes="filter-box" ItemsSource="{Binding Collections}"
                        SelectedItem="{Binding SelectedCollection, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding UndatedBroadcasts}" SelectedItem="{Binding SelectedUndatedBroadcast, Mode=TwoWay}"
                     IsVisible="{Binding HasUndatedBroadcasts}" Margin="6" Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate><DataTemplate>
                <Border Padding="12,10" BorderBrush="{DynamicResource RvBorderBrush}" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3" MinWidth="0">
                      <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding ShowName}" Classes="muted" FontSize="10" />
                      <TextBlock Text="{Binding FileText}" Classes="subtle" FontSize="9" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding ParserText}" FontSize="9" Foreground="{DynamicResource RvWarningBrush}" />
                      <TextBlock Text="{Binding DateConfidence}" Classes="subtle" FontSize="9" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{Binding !HasUndatedBroadcasts}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24">
              <Border Width="54" Height="54" CornerRadius="17" Background="{DynamicResource RvSuccessSubtleBrush}">
                <Path Data="M4,11 L9,16 L20,5" Width="25" Height="25" Stretch="Uniform"
                      Stroke="{DynamicResource RvSuccessBrush}" StrokeThickness="2.5" StrokeLineCap="Round" StrokeJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Every broadcast has a date" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="No parser-undated audio remains in this show filter." Classes="muted" FontSize="10" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card" Padding="18">
        <Grid>
          <StackPanel IsVisible="{Binding !HasUndatedSelection}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
            <ContentControl Content="Radio mast" ContentTemplate="{StaticResource MissingArtworkIconTemplate}" Width="54" Height="54" />
            <TextBlock Text="Choose an undated broadcast" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Parser clues and manual date controls will appear here." Classes="muted" FontSize="10" TextAlignment="Center" />
          </StackPanel>
          <ScrollViewer IsVisible="{Binding HasUndatedSelection}" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="15">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding SelectedUndatedBroadcast.DisplayTitle}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedUndatedBroadcast.ShowName}" Classes="muted" />
                <TextBlock Text="{Binding SelectedUndatedBroadcast.FileText}" Classes="subtle" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
              <Border Classes="card-raised" Padding="12">
                <StackPanel Spacing="6">
                  <TextBlock Text="Parser assessment" Classes="section-title" />
                  <TextBlock Text="{Binding SelectedUndatedBroadcast.ParserText}" Foreground="{DynamicResource RvWarningBrush}" />
                  <TextBlock Text="{Binding SelectedUndatedBroadcast.ParserEvidence}" Classes="muted" FontSize="10" TextWrapping="Wrap" MaxLines="5" />
                  <TextBlock Text="{Binding SelectedUndatedBroadcast.ParserWarnings}" Classes="subtle" FontSize="9" TextWrapping="Wrap" MaxLines="4" />
                </StackPanel>
              </Border>
              <StackPanel Spacing="7">
                <TextBlock Text="Confirmed broadcast date" Classes="section-title" />
                <DatePicker SelectedDate="{Binding SelectedUndatedDate, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                <TextBlock Text="This writes protected manual provenance and will not be replaced by later parser scans." Classes="muted" FontSize="10" TextWrapping="Wrap" />
                <Button Content="Assign date" Classes="primary" Command="{Binding AssignUndatedDateCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" IsVisible="{Binding IsCoverageMode}" Classes="card" Padding="0" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <Border Padding="16,13" BorderBrush="{DynamicResource RvBorderBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,250" ColumnSpacing="14">
            <StackPanel Spacing="3">
              <TextBlock Text="Whole-show metadata coverage" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="Each square is one calendar day. Weekday gaps and thin metadata periods stand out across the complete run." Classes="muted" FontSize="10" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Coverage.RunText}" IsVisible="{Binding HasCoverage}" Classes="subtle" FontSize="10" />
            </StackPanel>
            <ComboBox Grid.Column="1" Classes="filter-box" ItemsSource="{Binding Collections}"
                      SelectedItem="{Binding SelectedCollection, Mode=TwoWay}" VerticalAlignment="Center">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <StackPanel IsVisible="{Binding NeedsCoverageShow}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
            <TextBlock Text="Choose a show" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="The heatmap covers one show’s entire dated run at a time." Classes="muted" />
          </StackPanel>
          <ScrollViewer IsVisible="{Binding HasCoverage}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="18" Spacing="16">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding Coverage.ShowName}" FontSize="20" FontWeight="Bold" />
                  <TextBlock Text="{Binding Coverage.SummaryText}" Classes="muted" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="4"><Border Classes="coverage-cell gap" /><TextBlock Text="Gap" Classes="muted" FontSize="9" VerticalAlignment="Center" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4"><Border Classes="coverage-cell missing" /><TextBlock Text="Missing audio" Classes="muted" FontSize="9" VerticalAlignment="Center" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4"><Border Classes="coverage-cell critical" /><TextBlock Text="Very thin" Classes="muted" FontSize="9" VerticalAlignment="Center" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4"><Border Classes="coverage-cell partial" /><TextBlock Text="Partial" Classes="muted" FontSize="9" VerticalAlignment="Center" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4"><Border Classes="coverage-cell complete" /><TextBlock Text="Strong" Classes="muted" FontSize="9" VerticalAlignment="Center" /></StackPanel>
                </StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding CoverageYears}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Grid ColumnDefinitions="54,Auto" ColumnSpacing="10" Margin="0,0,0,5">
                    <TextBlock Text="{Binding Year}" FontWeight="Bold" FontSize="13" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="54" Rows="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Classes="coverage-cell"
                                Classes.weekend="{Binding IsWeekend}"
                                Classes.gap="{Binding IsGap}"
                                Classes.missing="{Binding IsKnownMissing}"
                                Classes.critical="{Binding IsCritical}"
                                Classes.sparse="{Binding IsSparse}"
                                Classes.partial="{Binding IsPartial}"
                                Classes.complete="{Binding IsComplete}"
                                ToolTip.Tip="{Binding ToolTipText}" />
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <StackPanel IsVisible="{Binding ShowCoverageEmptyState}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
            <TextBlock Text="No dated run is available" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="This show needs at least one dated library or Research record before a heatmap can be drawn." Classes="muted" FontSize="10" TextAlignment="Center" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
