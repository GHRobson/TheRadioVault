<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheRadioVault.Desktop.Avalonia.Views.LiveRadioView">
  <ScrollViewer>
    <StackPanel Margin="{StaticResource RvPagePadding}" Spacing="18" MaxWidth="980" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="3">
          <TextBlock Text="Radio Vault Live" Classes="display-title" />
          <TextBlock Text="Your archive, playing like live radio." Classes="muted" FontSize="12" />
        </StackPanel>
        <Button Grid.Column="1" Classes="secondary" Command="{Binding RefreshCommand}" Content="Refresh schedule" />
      </Grid>

      <Border Classes="card" Padding="28" Background="{DynamicResource RvAccentSubtleBrush}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10" ColumnSpacing="18">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <Ellipse Width="9" Height="9" Fill="{DynamicResource RvAccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="LIVE" Foreground="{DynamicResource RvAccentBrush}" FontWeight="Bold" FontSize="12" />
            <TextBlock Text="{Binding StationName}" Classes="muted" FontSize="12" />
          </StackPanel>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Subtitle}" FontSize="16" Foreground="{DynamicResource RvMutedTextBrush}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding SelectionReason}" FontSize="13" Foreground="{DynamicResource RvSubtleTextBrush}" TextWrapping="Wrap" />
          <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Spacing="5" Margin="0,10,0,0">
            <ProgressBar Classes="thin" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="6" />
            <Grid ColumnDefinitions="*,Auto,*">
              <TextBlock Text="{Binding PositionText}" FontFamily="Monospace" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontFamily="Monospace" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding RemainingText}" FontFamily="Monospace" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>
          </StackPanel>
          <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
            <Button Classes="primary" Command="{Binding TuneInCommand}" Content="Tune in" IsVisible="{Binding !IsTunedIn}" MinWidth="130" />
            <Button Classes="secondary" Command="{Binding LeaveCommand}" Content="Leave Live Radio" IsVisible="{Binding IsTunedIn}" MinWidth="150" />
            <Button Classes="secondary" Command="{Binding SaveMomentCommand}" Content="Save This Moment" IsVisible="{Binding IsTunedIn}" MinWidth="150" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="How it works" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="The server publishes one shared schedule and clock, so every Radio Vault device hears the same programme at the same point. Live listening does not change played status, progress, Continue Listening, play counts, your queue or handoff ownership. Save a Moment to return to the exact point later in the regular Library."
                     Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <StackPanel Spacing="10">
        <TextBlock Text="Coming up" FontSize="20" FontWeight="Bold" />
        <ItemsControl ItemsSource="{Binding Upcoming}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Padding="14" Margin="0,0,0,8">
                <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="14">
                  <TextBlock Text="{Binding Value.StartsAt, StringFormat={}{0:HH:mm}}" Foreground="{DynamicResource RvAccentBrush}" FontWeight="Bold" FontSize="16" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Reason}" Classes="muted" FontSize="11" TextWrapping="Wrap" MaxWidth="260" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
