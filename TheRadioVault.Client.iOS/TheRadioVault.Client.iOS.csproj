<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TheRadioVault.Client.iOS</RootNamespace>
    <AssemblyName>TheRadioVault.Client.iOS</AssemblyName>
    <ApplicationTitle>The Radio Vault</ApplicationTitle>
    <ApplicationId>com.ghrobson.theradiovault</ApplicationId>
    <ApplicationDisplayVersion>0.35.0</ApplicationDisplayVersion>
    <ApplicationVersion>35</ApplicationVersion>
    <CodesignEntitlements Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">Entitlements.device.plist</CodesignEntitlements>
    <!-- Avalonia 12.1's design-time helper emits an aggregate linker warning;
         application and framework warnings remain errors in CI. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="12.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TheRadioVault.Client.Mobile\TheRadioVault.Client.Mobile.csproj" />
  </ItemGroup>
</Project>
