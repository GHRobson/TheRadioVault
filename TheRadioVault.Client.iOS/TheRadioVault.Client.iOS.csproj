<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TheRadioVault.Client.iOS</RootNamespace>
    <AssemblyName>TheRadioVault.Client.iOS</AssemblyName>
    <ApplicationTitle>The Radio Vault</ApplicationTitle>
    <ApplicationId>com.ghrobson.theradiovault</ApplicationId>
    <ApplicationDisplayVersion>0.37.1</ApplicationDisplayVersion>
    <ApplicationVersion>38</ApplicationVersion>
    <AppIcon>AppIcon</AppIcon>
    <CodesignEntitlements Condition="'$(RuntimeIdentifier)' == 'ios-arm64' and '$(Configuration)' != 'DeviceTest'">Entitlements.device.plist</CodesignEntitlements>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'DeviceTest'">
    <!-- Free Personal Team provisioning cannot use Apple's managed multicast entitlement.
         This temporary configuration relies on manual server-address pairing instead. -->
    <ApplicationId>com.ghrobson.theradiovault.devicetest</ApplicationId>
    <ApplicationTitle>Radio Vault Test</ApplicationTitle>
    <CodesignProvision>Automatic</CodesignProvision>
    <CodesignKey>Apple Development</CodesignKey>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TheRadioVault.Client.Mobile\TheRadioVault.Client.Mobile.csproj" />
  </ItemGroup>
</Project>
