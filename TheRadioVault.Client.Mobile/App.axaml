<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheRadioVault.Client.Mobile.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="RvBackgroundBrush" Color="#111317" />
          <SolidColorBrush x:Key="RvSurfaceBrush" Color="#1C2026" />
          <SolidColorBrush x:Key="RvRaisedBrush" Color="#242A31" />
          <SolidColorBrush x:Key="RvBorderBrush" Color="#363D46" />
          <SolidColorBrush x:Key="RvTextBrush" Color="#F5F6F8" />
          <SolidColorBrush x:Key="RvMutedBrush" Color="#AFB5BD" />
          <SolidColorBrush x:Key="RvAccentBrush" Color="#F2C94C" />
          <SolidColorBrush x:Key="RvAccentTextBrush" Color="#18140A" />
          <SolidColorBrush x:Key="RvSuccessBrush" Color="#4FD3A0" />
          <SolidColorBrush x:Key="RvDangerBrush" Color="#F87182" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="RvBackgroundBrush" Color="#F4F5F8" />
          <SolidColorBrush x:Key="RvSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="RvRaisedBrush" Color="#ECEEF4" />
          <SolidColorBrush x:Key="RvBorderBrush" Color="#D8DCE5" />
          <SolidColorBrush x:Key="RvTextBrush" Color="#171923" />
          <SolidColorBrush x:Key="RvMutedBrush" Color="#626B7A" />
          <SolidColorBrush x:Key="RvAccentBrush" Color="#C58B00" />
          <SolidColorBrush x:Key="RvAccentTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="RvSuccessBrush" Color="#17865C" />
          <SolidColorBrush x:Key="RvDangerBrush" Color="#C83D52" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RvTextBrush}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource RvAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource RvAccentTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="MinHeight" Value="58" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
  </Application.Styles>
</Application>
