+        var progress = new Progress<LibraryTruthRehearsalProgress>(update =>
+        {
+            StatusText.Text = $"{update.Stage}: {update.Message}" +
+                              (update.Total > 1 ? $" ({update.Completed:N0}/{update.Total:N0})" : string.Empty);
+        });
