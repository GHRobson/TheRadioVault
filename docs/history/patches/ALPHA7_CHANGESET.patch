+        {
+            var summary = await Task.Run(() => _rehearsal.Run(AppPaths.BackupDirectory, progress));
+            MessageBox.Show(
+                this,
+                $"{summary.Message}\n\n{summary.SummaryDisplay}\nBackup: {summary.BackupPath}",
+                "Adoption rehearsal completed",
+                MessageBoxButton.OK,
+                MessageBoxImage.Information);
+            await ReloadAsync();
+            TruthTabs.SelectedIndex = 5;
+        }
+        catch (Exception ex)
+        {
+            MessageBox.Show(this, ex.Message, "Adoption rehearsal failed safely", MessageBoxButton.OK, MessageBoxImage.Error);
+            await ReloadAsync();
+        }
+        finally
+        {
+            RunRehearsalButton.IsEnabled = true;
+        }
