             var planTask = Task.Run(_engine.GetAdoptionPlanSummary);
             var rehearsalSummaryTask = Task.Run(_rehearsal.GetLatestSummary);
-            var rehearsalItemsTask = Task.Run(_rehearsal.GetLatestItems);
+            var rehearsalItemsTask = Task.Run(() => _rehearsal.GetLatestItems());
             var yearsTask = Task.Run(_engine.GetYears);
             var conflictsTask = Task.Run(_engine.GetConflicts);
             await Task.WhenAll(filesTask, recordingsTask, broadcastsTask, adoptionTask, coverageTask, previewTask, planTask, rehearsalSummaryTask, rehearsalItemsTask, yearsTask, conflictsTask);
