+# C# optional-parameter methods cannot be passed as zero-argument Task.Run method groups.
+$libraryTruthWindowText = Get-Content (Join-Path $root "TheRadioVault\LibraryTruthWindow.xaml.cs") -Raw
+if ($libraryTruthWindowText -match 'Task\.Run\(_rehearsal\.GetLatestItems\)') {
+    Add-ValidationError "LibraryTruthWindow must invoke GetLatestItems through an explicit lambda because the method has an optional limit parameter."
+}
+if ($libraryTruthWindowText -notmatch 'Task\.Run\(\(\)\s*=>\s*_rehearsal\.GetLatestItems\(\)\)') {
+    Add-ValidationError "The alpha7 rehearsal item load must use Task.Run(() => _rehearsal.GetLatestItems())."
+}
+
 # Version drift is easy to introduce when packaging source builds.
