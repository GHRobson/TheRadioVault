+# Alpha8 buildfix2: avoid a malformed multi-line interpolated raw string in the
+# conflict-forensics selection handler. Conventional interpolated strings are
+# deliberately used here so the source compiles on the supported C# toolchain.
+if ($libraryTruthWindowText -match '\?\s*\$"""\{item\.Evidence\}') {
+    Add-ValidationError "ConflictForensicsGrid_SelectionChanged must not use the malformed inline raw string from alpha8 buildfix1."
+}
+foreach ($requiredFragment in @(
+    'Candidate values:\n{item.CandidateValues}',
+    'Provenance:\n{item.Provenance}',
+    'Preserved alternates: {item.PreservedAlternateCount:N0}'
+)) {
+    if ($libraryTruthWindowText -notmatch [regex]::Escape($requiredFragment)) {
+        Add-ValidationError "Alpha8 buildfix2 conflict evidence formatting is missing: $requiredFragment"
+    }
+}
+
