+                ("$value", collectionId), ("$episode", survivorEpisodeId));
+            return;
+        }
+        Execute(connection, transaction, $"UPDATE episodes SET {field}=$value WHERE id=$episode",
+            ("$value", selectedValue), ("$episode", survivorEpisodeId));
